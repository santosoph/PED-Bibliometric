	year = {2026},
	journal = {Physics Education},
	volume = {61},
	number = {4},
	pages = {},
	doi = {10.1088/1361-6552/ae8498},
	url = {https://www.scopus.com/pages/publications/105046044908?origin=resultslist},
	affiliations = {Departamento de Física, CFisUC, IFIMUP, Faculdade de Ciências e Tecnologia, Universidade de Coimbra, Coimbra, Portugal; Departamento Física Astronomia, IFIMUP, Unidade de Ensino das Ciências, Faculdade de Ciências, Universidade do Porto, Porto, Portugal; CIDTFF, Departamento de Educação e Psicologia, Universidade de Aveiro, Aveiro, Portugal; Departamento de Física e Astronomia, IFIMUP, Unidade de Ensino das Ciências, Faculdade de Ciências, Universidade do Porto, Porto, Portugal; Colégio Novo da Maia, Maia, Portugal},
	abstract = {In the context of the growing integration of Artificial Intelligence (AI) in education, it is essential to understand how these technologies are incorporated into teaching practices and how they influence the development of transversal skills. Despite the rapid dissemination of generative AI (GenAI) tools, there remains a lack of applied research at the lower secondary education level. This qualitative and exploratory study was conducted with a 7th-grade class in the subject of Physics in Portugal. Its main goal was to analyse the effects of using GenAI in school research tasks, exploring how it influences students’ access to information, peer collaboration, and critical thinking. The findings reveal that although GenAI facilitates access to and organisation of information, it also promotes uncritical use and reduce peer interaction. Conversely, tasks carried out without GenAI were characterised by greater collaboration, source verification, and cognitive engagement. The study concludes that the integration of GenAI in teaching should be both critical and pedagogically guided, promoting students’ autonomy, digital literacy, and reflective thinking. The research indicates the importance of preparing teachers and students for the ethical and informed use of these tools in educational contexts. © 2026 The Author(s). Published by IOP Publishing Ltd. Original content from this work may be used under the terms of the Creative Commons Attribution 4.0 license. Any further distribution of this work must maintain attribution to the author(s) and the title of the work, journal citation and DOI.},
	author_keywords = {collaborative work; critical thinking; digital literacy; generative artificial intelligence; lower secondary level; middle school; physics education},
	correspondence_address = {M.D. Hahn; Departamento de Física, CFisUC, IFIMUP, Faculdade de Ciências e Tecnologia, Universidade de Coimbra, Coimbra, Portugal; email: marcelo.hahn@uc.pt},
	publisher = {Institute of Physics},
