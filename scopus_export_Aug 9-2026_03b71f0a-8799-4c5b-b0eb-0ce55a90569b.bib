@ARTICLE{Dao2023,
	author = {Dao, Duc Long},
	title = {Experimental evaluation of damping models for a nonlinear pendulum system},
	year = {2023},
	journal = {Physics Education},
	volume = {58},
	number = {5},
	pages = {},
	doi = {10.1088/1361-6552/ace1ca},
