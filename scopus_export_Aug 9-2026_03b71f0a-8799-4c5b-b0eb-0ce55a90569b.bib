@ARTICLE{Gjerde2021,
	author = {Gjerde, Vegard and Gray, Robert and Holst, Bodil and Kolst, Stein Dankert},
	title = {The Covid-19 shutdown: When studying turns digital, students want more structure},
	year = {2021},
