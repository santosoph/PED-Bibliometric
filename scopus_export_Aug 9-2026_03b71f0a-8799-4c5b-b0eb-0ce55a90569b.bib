	title = {Investigating the time-distance relationship: an innovative approach to Galileo's inclined plane experiment using Arduino},
	year = {2024},
	journal = {Physics Education},
	volume = {59},
	number = {6},
	pages = {},
	doi = {10.1088/1361-6552/ad7c0d},
	url = {https://www.scopus.com/pages/publications/85208057580?origin=resultslist},
	affiliations = {Universidade de São Paulo, Instituto de Física de São Carlos, SP, São Carlos, Brazil},
	abstract = {In this paper, we present an innovative approach to hands-on scientific inquiry, for classroom use, by integrating modern tools such as reflective photointerrupter sensors and sound emitters into an experimental setup. Inspired by Galileo’s pioneering work, our proposed experiments investigate the relationship between sound intervals and the motion of an object along an inclined U-shaped profile. Using different sensor arrangements, we explore the quadratic relationship between distance and time for spheres rolling on the inclined plane. Additionally, we discuss a simplified theoretical framework facilitating comparison between theoretical and experimental acceleration values. Our findings demonstrated a close correspondence between experimental distance-time data and theoretical predictions, validating the effectiveness of our approach. © 2024 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved.},
	author_keywords = {Arduino; inclined plane; physics teachers; rotational motion},
	correspondence_address = {J.F.M. dos Santos; Universidade de São Paulo, Instituto de Física de São Carlos, São Carlos, SP, Brazil; email: jessica.santos@usp.br},
	publisher = {Institute of Physics},
	issn = {00319120},
	language = {English},
	abbrev_source_title = {Phys. Educ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@ARTICLE{Wibowo2026,
	author = {Wibowo, Edy and Ulya, Naily and Rokhmat, Mamat},
	title = {From rolling to reasoning: reframing the ‘confirm g’ experiment into inquiry-based learning},
	year = {2026},
	journal = {Physics Education},
	volume = {61},
	number = {1},
	pages = {},
	doi = {10.1088/1361-6552/ae19bc},
	url = {https://www.scopus.com/pages/publications/105032408079?origin=resultslist},
	affiliations = {School of Electrical Engineering, Telkom University, West Java, Jl. Telekomunikasi No. 1, Terusan Buah Batu, Bandung, Indonesia; Center of Excellence for Sustainable Energy and Climate Change, Telkom University, Jl. Telekomunikasi No. 1, Terusan Buah Batu, Bandung, Indonesia; Department of Physics, Faculty Mathematics and Natural Science, Universitas Kebangsaan Republik Indonesia, West Java, Bandung, Indonesia},
	abstract = {Here, we present an inquiry-based, low-cost rolling motion experiment as an alternative to traditional ‘confirm g ‘activities, integrating both confirmatory and inquiry-based elements. Using seven everyday objects—modeled as hollow spheres, solid cylinders, and solid spheres—rolled down a 7.7<sup>◦</sup> incline, students can estimate g within 9.94–10.86 m s<sup>−</sup><sup>2</sup>. Variations due to mass distribution, rolling stability, and material properties serve as entry points for reasoning about translational motion, rotational dynamics, and energy conservation. The experiment is embedded in a structured learning cycle (prediction, measurement with smartphone-based video analysis, interpretation, and reflection) and supported by a ready-to-use worksheet (appendix). In this way, the activity reframes the familiar’confirm g’ experiment into an inquiry-based learning experience that promotes conceptual understanding, critical thinking, and authentic scientific reasoning. © 2025 IOP Publishing Ltd.},
	author_keywords = {gravitational acceleration; inclined plane experiment; inquiry-based learning; moment of inertia; physics education; rolling motion; smartphone video analysis},
	correspondence_address = {E. Wibowo; School of Electrical Engineering, Telkom University, Bandung, West Java, Jl. Telekomunikasi No. 1, Terusan Buah Batu, Indonesia; email: edyw.phys@gmail.com},
	publisher = {Institute of Physics},
	issn = {00319120},
	language = {English},
	abbrev_source_title = {Phys. Educ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

