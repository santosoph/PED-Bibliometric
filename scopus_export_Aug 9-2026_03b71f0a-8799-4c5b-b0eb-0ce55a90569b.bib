@ARTICLE{Dumas Hahn2026,
	author = {Dumas Hahn, Marcelo and Xisto Silva Silveira, Michel and Alan de Oliveira Cruz, Frederico and Carvalho, Paulo Simeão},
	title = {Simulating non-ideal multimeters: revisiting the ammeter–voltmeter method},
	year = {2026},
	journal = {Physics Education},
	volume = {61},
