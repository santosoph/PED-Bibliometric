@ARTICLE{Savchenko2024,
	author = {Savchenko, Dariya and Chyzhska, Tetyana and Shtofel, Olha},
	title = {Teaching the asynchronous general physics course in a crisis context: a case study at Igor Sikorsky Kyiv Polytechnic Institute},
	year = {2024},
