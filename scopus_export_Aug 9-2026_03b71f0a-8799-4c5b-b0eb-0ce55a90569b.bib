	correspondence_address = {A. Kaps; Didactics of Physics, University of Leipzig, Leipzig, Prager Straße 36, 04317, Germany; email: stallmac@physik.uni-leipzig.de; F. Stallmach; Didactics of Physics, University of Leipzig, Leipzig, Prager Straße 36, 04317, Germany; email: stallmac@physik.uni-leipzig.de},
