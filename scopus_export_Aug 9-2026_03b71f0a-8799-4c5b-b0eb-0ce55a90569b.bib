	url = {https://www.scopus.com/pages/publications/105033834035?origin=resultslist},
	affiliations = {Cao Thang Technical College, Ho Chi Minh City, Viet Nam},
	abstract = {This study proposes a framework for integrating physics and engineering practice to enhance first-year engineering students’ physics learning in a college engineering program. A mixed-method research design was employed to assess the framework’s effectiveness. Quantitative data were collected through a questionnaire measuring students’ perceptions of physics learning in an engineering context, while qualitative insights were gathered via semi-structured interviews before and after the intervention. The study population consists of first-year engineering students in the Department of Mechanical Engineering, comprising five classes at a technical college during the 2023-2024 academic year. One class was randomly selected and served as the study sample. A paired sample t-test was applied to determine whether there was a statistically significant difference between pre-test and post-test scores. Furthermore, thematic analysis was conducted on qualitative data to identify key themes related to students’ engagement with physics and engineering practice. Findings revealed a statistically significant improvement in students’ perceptions of physics and engineering practice, suggesting that the proposed framework enhances students’ engineering problem-solving skills. These results highlight the potential of structured physics-engineering integration to enhance first-year engineering education by bridging theoretical physics with practical engineering applications, fostering problem-solving skills, increasing student engagement, and strengthening intrinsic learning motivation. © 2026 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved.},
	author_keywords = {engineering design process; engineering problem-solving; framework; physics and engineering practice; physics course},
