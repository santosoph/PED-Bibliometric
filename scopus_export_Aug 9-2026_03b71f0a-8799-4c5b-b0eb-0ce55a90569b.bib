	title = {Complex systems for high school physics: synchronization using low-cost experiments and the Kuramoto model},
	year = {2026},
	journal = {Physics Education},
	volume = {61},
	number = {2},
	pages = {},
	doi = {10.1088/1361-6552/ae3416},
	url = {https://www.scopus.com/pages/publications/105033725990?origin=resultslist},
	affiliations = {Instituto Federal do Rio de Janeiro, RJ, Volta Redonda, 27215-350, Brazil; Laboratório de Instrumentação e Simulação Computacional, Instituto Federal do Rio de Janeiro, RJ, Paracambi, 26600-000, Brazil; Fundação de Apoio à Escola Técnica, RJ, Resende, 27521-130, Brazil; Universidade Federal Fluminense, RJ, Volta Redonda, 27213-145, Brazil; Instituto Federal do Rio Grande do Norte, RN, Natal, 59015-000, Brazil},
	abstract = {This work presents a pedagogical approach for introducing synchronization phenomena in high school physics education through the Kuramoto model, contributing to complex systems education at the secondary level. Synchronization occurs when coupled oscillators, initially out of phase, begin to oscillate in phase with a common frequency due to coupling between their constituent elements. This phenomenon is widely observed in nature and artificial systems, from firefly flashing patterns to mechanical metronomes, yet remains largely absent from secondary education curricula. We propose a two-stage methodology to make this complex concept accessible to high school students. The first stage involves experimental investigation using video analysis with Tracker software to study coupled metronomes, allowing students to observe phase relationships and measure synchronization dynamics. The second stage utilizes computational simulations to explore the mathematical framework of the Kuramoto model and examine various coupling scenarios. This approach bridges the gap between advanced physics concepts typically reserved for university-level courses and secondary education, enabling educators to effectively teach sophisticated phenomena from complex systems at the high school level. The methodology integrates theoretical understanding with hands-on experimentation and computational modelling, providing students with multiple perspectives on synchronization phenomena. © 2026 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved.},
	author_keywords = {complex systems; Kuramoto model; oscillations; synchronization},
	correspondence_address = {P.V.S. Souza; Instituto Federal do Rio de Janeiro, Volta Redonda, RJ, 27215-350, Brazil; email: paulo.victor@ifrj.edu.br},
	publisher = {Institute of Physics},
	issn = {00319120},
	language = {English},
	abbrev_source_title = {Phys. Educ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Kuusisto2026,
	author = {Kuusisto, E. and Lehtinen, A. and Koskinen, P.},
	title = {Quantum physics meets computational thinking: accessing quantum mechanics with Python-based computational exercises},
	year = {2026},
	journal = {Physics Education},
	volume = {61},
	number = {1},
	pages = {},
	doi = {10.1088/1361-6552/ae1edd},
	url = {https://www.scopus.com/pages/publications/105034029327?origin=resultslist},
	affiliations = {Department of Physics, University of Jyväskylä, PO Box 35, Jyväskylä, 40014, Finland; Nanoscience Center, Department of Physics, University of Jyväskylä, PO Box 35, Jyväskylä, 40014, Finland},
	abstract = {Learning quantum mechanics (QMs) poses unique challenges due to its abstract, unintuitive nature and departure from classical physics paradigms. In this context, computational methods hold potential not only for improving conceptual understanding but also for addressing the motivational difficulties often encountered in learning QMs. This study investigates how computational Python exercises impact students’ experiences and conceptual understanding in a massive open online course designed for high school and early undergraduate students. Data was collected using an online questionnaire that probed the understanding of QMs concepts and computational methods. The 48 participants were randomly assigned to two groups that completed the questionnaire and the computational exercises in a different order. Students’ answers were studied using content analysis, rubrics, and statistical methods. The results suggest that while computational methods offer valuable means for concretizing abstract QM ideas, attention must be paid to how computational models are presented, particularly for students with limited computational background. This study provides preliminary evidence that a short, carefully designed computational intervention can positively influence students’ views on computational thinking. © 2025 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved.},
	author_keywords = {computational thinking; MOOC; quantum education},
	correspondence_address = {E. Kuusisto; Department of Physics, University of Jyväskylä, Jyväskylä, PO Box 35, 40014, Finland; email: eetu.ek.kuusisto@jyu.fi},
	publisher = {Institute of Physics},
	issn = {00319120},
	language = {English},
	abbrev_source_title = {Phys. Educ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

