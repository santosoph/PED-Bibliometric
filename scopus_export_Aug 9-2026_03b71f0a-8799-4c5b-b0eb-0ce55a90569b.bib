@ARTICLE{Cruz-Gómez2026,
	author = {Cruz-Gómez, Raúl C and Cros, Anne and de Velasco, Guillermo Gutiérrez and Ceja, Israel},
	title = {Enhanced damping of shallow-water sloshing induced by hydrophobic walls: a counterintuitive laboratory experiment for undergraduate physics},
	year = {2026},
	journal = {Physics Education},
	volume = {61},
	number = {3},
	pages = {},
	doi = {10.1088/1361-6552/ae5eed},
	url = {https://www.scopus.com/pages/publications/105037744122?origin=resultslist},
	affiliations = {Department of Physics, Centro Universitario de Ciencias Exactas e Ingenierías, Universidad de Guadalajara, Guadalajara, Mexico},
	abstract = {It is often expected that hydrophobic walls reduce viscous dissipation. However, our experimental results show that they instead increase the damping of shallow-water sloshing while leaving the natural oscillation frequency essentially unchanged. Two geometrically identical acrylic containers, differing only in wall wettability, are impulsively excited and the subsequent free-surface decay is recorded using a smartphone camera. Contrary to intuitive expectations, the hydrophobic container exhibits a decay time nearly three times shorter than the hydrophilic container. A shallow-water model reduces the dynamics to a damped harmonic oscillator, allowing students to extract frequency and decay rate independently through nonlinear regression and spectral analysis. The experiment provides a clear and accessible laboratory activity for upper-level undergraduate courses, illustrating the separation between restoring forces and dissipative mechanisms, the role of boundary conditions, and the exponential decay of mechanical energy in oscillatory systems. © 2026 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved. This article is available under the terms of the https://publishingsupport.iopscience.iop.org/iop-standard/v1.},
	author_keywords = {damped oscillations; energy dissipation; fluid mechanics; sloshing; surface wettability; undergraduate laboratory},
	correspondence_address = {R.C. Cruz-Gómez; Department of Physics, Centro Universitario de Ciencias Exactas e Ingenierías, Universidad de Guadalajara, Guadalajara, Mexico; email: raul.cruz@academicos.udg.mx; },
	publisher = {Institute of Physics},
	issn = {00319120},
	language = {English},
	abbrev_source_title = {Phys. Educ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

