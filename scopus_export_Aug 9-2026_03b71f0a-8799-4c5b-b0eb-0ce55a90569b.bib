@ARTICLE{Jones1981356,
	author = {Jones, Hugh G. and Mooney, Robert J.},
	title = {An approach to conceptual difficulties in physics},
	year = {1981},
	journal = {Physics Education},
	volume = {16},
	number = {6},
	pages = {356 - 359},
	doi = {10.1088/0031-9120/16/6/312},
	url = {https://www.scopus.com/pages/publications/36149048641?origin=resultslist},
	abstract = {We have given an account of the 'skeleton' of an approach which our students have found useful in preparation for the conceptual hurdles which must be negotiated during a physics course. The desirable features of this approach are (a) it provides for the 'normalisation' of an otherwise heterogeneous group of students, (b) it gives a visual perception of the wide range of phenomena physicists seek to understand, (c) the 'world map' provides a reference for the whole of a physics course and can be refined as the student's knowledge of physics increases, (d) the construction of the world map is a very interactive process which not only builds on the student's current knowledge and views of physics but also provides an opportunity to 'whet the student's appetite' for physics as he/she starts a degree course. We suggest that it is possible to present the world map to students at an appropriate time during their sixth-form studies. The examples used can be tailored to suit the teacher/student group. Only the overall structure of the map need be retained. There is, based on our experience, only one danger in using this approach. The temptation to overelaborate, by way of giving too many or using too subtle a set of examples, should be resisted. The extension and development of this approach comes later!},
	issn = {00319120},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
