@ARTICLE{Pal2026,
	author = {Pal, Sanjoy Kumar and Mondal, Papun and Panchadhyayee, Pradipta and Samanta, Subhash Chandra},
	title = {Time-domain verification of Ohm’s law using a fixed resistor in an RC circuit},
	year = {2026},
	journal = {Physics Education},
	volume = {61},
	number = {3},
	pages = {},
	doi = {10.1088/1361-6552/ae58e4},
	url = {https://www.scopus.com/pages/publications/105037762785?origin=resultslist},
	affiliations = {Dept. of Physical Science, Anandapur High School, Paschim Medinipur, West Bengal, Anandapur, 721122, India; Institute of Astronomy, Space and Earth Science, West Bengal, Kolkata, 700054, India; Department of Physics (UG & PG), Prabhat Kumar College, Purba Medinipur, Contai, India; IAPT-Midnapore College Centre for Scientific Culture, Paschim Midnapore, West Bengal, India},
	abstract = {Ohm’s law is traditionally verified in physics laboratories under steady-state conditions by varying resistance and measuring corresponding current–voltage pairs. While operationally effective, this approach often obscures the instantaneous and local nature of Ohm’s law and encourages the misconception that the law is valid only for constant currents. In this article, a time-domain verification of Ohm’s law is presented using a fixed resistor in a series resistor (R)-capacitor (C) circuit. The charging and discharging of a capacitor driven by a low-voltage DC source are studied by simultaneously measuring voltage and current as functions of time. Experimental voltage–time and current–time data exhibit the expected exponential behaviour, while the voltage–current plots (voltage versus corresponding current at any instant) obtained from measurements taken at different times during charging and discharging yield straight lines with nearly identical slopes. The results demonstrate that, despite the circuit being globally non-Ohmic, the variation of voltage and current through the resistor obeys Ohm’s law instantaneously at all times. The experiment provides a complementary, conceptually rich alternative to the conventional rheostat-based verification of Ohm’s law, while the present method offers a conceptually richer yet experimentally easier means of understanding the instantaneous and local nature of Ohm’s law in time-dependent circuits. © 2026 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved. This article is available under the terms of the https://publishingsupport.iopscience.iop.org/iop-standard/v1.},
	author_keywords = {RC circuit; time-domain analysis of Ohm’s law; transient current},
	correspondence_address = {S.K. Pal; Dept. of Physical Science, Anandapur High School, Anandapur, Paschim Medinipur, West Bengal, 721122, India; email: sanjoypal83@gmail.com},
	publisher = {Institute of Physics},
	issn = {00319120},
	language = {English},
	abbrev_source_title = {Phys. Educ.},
	type = {Article},
	publication_stage = {Final},
