@ARTICLE{Legerská2025,
	author = {Legerská, Jana and Henriksen, Ellen Karoline and Bøe, Maria Vetleseter},
	title = {Learning goals in upper secondary quantum physics: Norwegian teachers’ perspectives},
	year = {2025},
	journal = {Physics Education},
	volume = {60},
	number = {4},
	pages = {},
	doi = {10.1088/1361-6552/ade259},
	url = {https://www.scopus.com/pages/publications/105009156219?origin=resultslist},
	affiliations = {Department of Physics Education, Charles University, Prague, Czech Republic; Department of Physics, University of Oslo, Oslo, Norway},
	abstract = {Quantum physics (QP) is an important part of physics education, especially with the current developments in quantum technology. As upper-secondary curricula often allow teachers great freedom in deciding what to focus on, this study explores teachers’ choices of learning goals in QP in upper-secondary schools in Norway, and their underlying motivations. We collected data from teachers via an electronic questionnaire (N = 30) and individual interviews (N = 4). The analysis shows that teachers’ choices of learning goals in QP centred around three themes: Basic principles of QP, Phenomena and experiments, and Philosophical aspects, and the first two received significantly more attention. Teachers largely focused on traditional topics like wave-particle duality and key experiments, while under emphasising the probabilistic nature of measurement, superposition and entanglement, which are necessary for understanding quantum technologies. Teachers’ choices were largely influenced by the national exam and the perceived teachability of individual topics. To enhance quantum literacy, the study calls for innovative approaches to teaching QP emphasising its underlying principles over traditional paradigms. © 2025 The Author(s). Published by IOP Publishing Ltd.},
	author_keywords = {learning goals; physic education; quantum physics; upper secondary school},
	correspondence_address = {J. Legerská; Department of Physics Education, Charles University, Prague, Czech Republic; email: jana.legerska@matfyz.cuni.cz},
	publisher = {Institute of Physics},
	issn = {00319120},
	language = {English},
	abbrev_source_title = {Phys. Educ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Hybrid Gold Open Access}
}

