	year = {2002},
	journal = {Physics Education},
	volume = {37},
	number = {3},
	pages = {254 - 256},
	doi = {10.1088/0031-9120/37/3/402},
	url = {https://www.scopus.com/pages/publications/85071216924?origin=resultslist},
	affiliations = {Harvard Extension School, Cambridge, MA, 02138, United States; Noble and Greenough School, Dedham, MA, 02026, United States},
	abstract = {We feel that the whole vector method offers enormous pedagogical advantages over the component method. The component method begins with normal force and the friction force, which are perpendicular and parallel to the road itself. Yet the analysis is carried out in terms of the horizontal and vertical directions. This is the source of much student confusion. By beginning with the single, undecomposed road force, one sees immediately how the road force must change to affect the net force that depends upon the actual speed. The direction that the friction takes follows clearly from the diagrams. If the speed is greater than the critical speed, the friction points down along the road. If it is less than the critical speed, the friction points up along the road. Since we are not actually calculating with the components, we avoid the need to take x and y-components of the normal and friction vectors, a calculation that confuses many students. As for the elegance and ease of calculation, this is manifestly evident from the sample problem solved above. We have tried this approach and have found it accepted enthusiastically by the students. We owe Wheeler a great debt. © 2002 IOP Publishing Ltd.},
	issn = {00319120},
	language = {English},
	abbrev_source_title = {Phys. Educ.},
