	year = {2025},
	journal = {Physics Education},
	volume = {60},
	number = {5},
	pages = {},
	doi = {10.1088/1361-6552/adea06},
	url = {https://www.scopus.com/pages/publications/105011312496?origin=resultslist},
	affiliations = {Engineering Physics, School of Electrical Engineering, Telkom University, West Java, Bandung, Indonesia; Center of Excellence for Sustainable Energy and Climate Change, Telkom University, Jl. Telekomunikasi No. 1 Terusan Buah Batu, Bandung, Indonesia; Department of Physics, Faculty Mathematics and Natural Science, Universitas Kebangsaan Republik Indonesia, West Java, Bandung, Indonesia},
	abstract = {This study investigates the curved rolling motion of a toy bowling pin by modelling it as a rigid two-wheel system with unequal radii. The pin’s asymmetrical shape—wider at the base and narrower at the top—causes a mismatch in linear velocities at each end during rolling without slipping, resulting in a circular trajectory. A mathematical expression for the turning radius is derived based solely on the radii of the wheels and the distance between them. To validate the model, experiments were conducted using three types of toy bowling pins—white, yellow, and blue—and their rolling trajectories were analysed through video tracking. The measured turning radii were 20.03 ± 0.44 cm (white), 20.61 ± 0.53 cm (yellow), and 19.90 ± 0.78 cm (blue). The theoretical predictions showed strong agreement with the experimental data, with percentage errors ranging from 1.94% to 10.24%. These findings demonstrate that a simple, low-cost object can effectively illustrate fundamental concepts in rotational dynamics—such as angular velocity and rolling constraints—making them more tangible, accessible, and engaging for students in physics education. © 2025 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved.},
	author_keywords = {curved rolling motion; experimental; toy bowling pin; turning radius; two-wheel model},
