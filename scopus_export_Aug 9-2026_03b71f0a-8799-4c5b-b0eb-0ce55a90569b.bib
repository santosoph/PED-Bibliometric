	pages = {128 - 132},
	doi = {10.1088/0031-9120/24/3/303},
	url = {https://www.scopus.com/pages/publications/36149028893?origin=resultslist},
	abstract = {The strength and skill involved in balletic turns - a source of wonder to the watcher - is here subject to physical analysis, the more to make us marvel. Movements of various parts of the body are correlated both with the time variation of the angular momentum and with the velocity of the dancer. Table 1 gives a comparison of the maximum angular momentum and duration of the turn for the three movements. It can be seen that the maximum angular momentum given to the dancer in the en dehors and sauté en dehors turns are equal but that the period of the turn is much less in the latter. As noted above, this is due to the moment of inertia being much less in the sauté configuration of the body in which the arms are held tight into the body and both legs are vertical. Consequently the angular velocity is greater in the sauté turn, resulting in the shorter period. Movement of the arms and the free leg in the en dehors and fouetté turns causes changes in the moment of inertia, and hence in the angular velocity of the dancer, which can produce perturbations in the rotation of the turntable because of the relative motion between parts of the body. However, the motion may be complicated by any tilt or non-collinearity of the body axis of rotation and that of the turntable.},
	issn = {00319120},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

