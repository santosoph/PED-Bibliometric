@ARTICLE{Newburgh200911,
	author = {Newburgh, Ronald and Rueckner, Wolfgang},
	title = {Frequency in vertical SHM is unaffected by gravity},
	year = {2009},
	journal = {Physics Education},
	volume = {44},
	number = {1},
	pages = {11 - 14},
	doi = {10.1088/0031-9120/44/1/F03},
	url = {https://www.scopus.com/pages/publications/64549090034?origin=resultslist},
	affiliations = {Harvard University Extension School, Cambridge, MA, United States; Science Center, Harvard University, Cambridge, MA, United States},
	abstract = {The unstretched, massless spring has no potential energy. When the spring is relaxed it has a length, L. We designate the position of the spring's tip as x = 0. Hanging a mass at the tip moves it to x0. The spring is then stretched to a length L + x0 and has gravitational and elastic PE. This energy has the value (-kx0 2/2) and we have called it the null energy. If displaced from x0 by a distance A, the mass oscillates about x0 with amplitude A and angular frequency w equal to (k/m)1/2. We then find that, for all of the values of x between x0 - A and x0 + A, the total energy of the system equals the null energy plus the mechanical energy associated with the oscillation. The null energy is a constant so that, for any calculation of energy differences between two states, it plays no role. There is no change in total energy during the oscillation. Heat is not absorbed or lost so we can characterize it as isenergetic and isentropic. We may therefore interpret the null energy as a constant internal energy in the thermodynamic sense. To encounter an internal energy in the problem is interesting. Usually the first introduction of internal energy is in thermodynamics. No such energy exists in point particles, which are so beloved in elementary physics. This is why we write the work-energy theorem by equating the work done on a particle with the change in its kinetic energy.},
	correspondence_address = {R. Newburgh; Harvard University Extension School, Cambridge, MA, United States; email: rgnew@verizon.net},
	issn = {13616552},
	language = {English},
	abbrev_source_title = {Phys. Educ.},
